-- 1. Pengaturan efek blur global
-- (harus lewat hl.config; "hl.decoration = {...}" hanya mengisi variabel Lua dan tidak mengatur Hyprland)
hl.config({
    decoration = {
        blur = {
            enabled = true,
            size = 4,
            passes = 3,
            new_optimizations = true,
            xray = true,
        },
    },
})

-- 2. Semua window: nyalakan blur dan buat agak transparan
-- Blur hanya terlihat kalau window tembus pandang, dan rule ini juga menimpa
-- rule bawaan dotfiles yang mungkin mematikan blur untuk semua class.
-- Harus ditaruh SEBELUM pengecualian di bawah.
hl.window_rule({
    match = { class = ".*" },
    no_blur = false,
    opacity = "0.85 0.85",
})

-- 3. Pengecualian untuk Google Chrome
hl.window_rule({
    match = { class = "^(google-chrome)$" },
               no_blur = true,
               opaque = true,
               opacity = "1.0 1.0",
})

-- 4. Pengecualian untuk Steam client
hl.window_rule({
    match = { class = "^(steam)$" },
               no_blur = true,
               opaque = true,
               opacity = "1.0 1.0",
})

-- 5. Pengecualian untuk semua game Steam (Proton/Wine/Native)
hl.window_rule({
    match = { class = "^(steam_app_.*)$" },
               no_blur = true,
               opaque = true,
               opacity = "1.0 1.0",
})

-- 6. Pengecualian untuk Gamescope
hl.window_rule({
    match = { class = "^(gamescope)$" },
               no_blur = true,
               opaque = true,
               opacity = "1.0 1.0",
})


-- >>> macmono >>>
-- Blur untuk shell macmono (menubar, control center, dock, notifikasi)
hl.layer_rule({ match = { namespace = "^macmono:(menubar|cc|dock|notif)$" }, blur = true })
hl.layer_rule({ match = { namespace = "^macmono:(menubar|cc|dock|notif)$" }, ignore_alpha = 0.2 })
-- Launcher & wallpaper picker: cuma kartunya yang di-blur, latar redup nggak ikut
hl.layer_rule({ match = { namespace = "^macmono:(launcher|wallpaper-picker)$" }, blur = true })
hl.layer_rule({ match = { namespace = "^macmono:(launcher|wallpaper-picker)$" }, ignore_alpha = 0.55 })
